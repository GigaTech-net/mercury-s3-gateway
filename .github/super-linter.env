# Loaded by the super-linter composite action, which configures nothing itself --
# without this file it falls through to Super-Linter's defaults and lints the whole
# codebase with every linter.
#
# Replaces the two rw-super-linter.yaml inputs this repo used to pass:
#
#   filter-regex-exclude: "[src|.github]/**"
#   forkedRepoLIntRestriction: true
#
# The second was only ever a list of VALIDATE_* values, so it maps directly onto the
# entries below -- no capability is lost by moving to the composite action. This
# repository is a fork and takes third-party contributions; the point is not to fail
# on lint errors in code we did not write.
#
# VALIDATE_SPELL_CODESPELL is off because quality-checks already runs codespell via
# the `spellcheck` action, which carries the org word list. Super-Linter's own copy
# has neither that nor wordsToIgnore, so the two disagree.
#
# Keys are alphabetically ordered: Super-Linter runs dotenv-linter over this file and
# UnorderedKey is an error. Do NOT add USE_FIND_ALGORITHM -- Super-Linter rejects it
# alongside VALIDATE_ALL_CODEBASE=false.
FILTER_REGEX_EXCLUDE=[src|.github]/**
IGNORE_GITIGNORED_FILES=true
LOG_LEVEL=WARN
VALIDATE_ALL_CODEBASE=false
VALIDATE_BASH=false
VALIDATE_BASH_EXEC=false
VALIDATE_BIOME_FORMAT=false
VALIDATE_BIOME_LINT=false
VALIDATE_CHECKOV=false
VALIDATE_CLOUDFORMATION=false
VALIDATE_EDITORCONFIG=false
VALIDATE_GITLEAKS=false
VALIDATE_JAVASCRIPT_PRETTIER=false
VALIDATE_JAVASCRIPT_STANDARD=false
VALIDATE_JSON_PRETTIER=false
VALIDATE_MARKDOWN=false
VALIDATE_MARKDOWN_PRETTIER=false
VALIDATE_NATURAL_LANGUAGE=false
VALIDATE_SHELL_SHFMT=false
VALIDATE_SPELL_CODESPELL=false
VALIDATE_TERRAFORM_TFLINT=false
VALIDATE_TRIVY=false
VALIDATE_TYPESCRIPT_PRETTIER=false
VALIDATE_TYPESCRIPT_STANDARD=false
VALIDATE_YAML_PRETTIER=false
