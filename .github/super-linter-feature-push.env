# Super-Linter config for feature-push.yaml ONLY. Identical to
# .github/super-linter-push.env except for FILTER_REGEX_EXCLUDE -- see that file
# for why VALIDATE_ALL_CODEBASE=true and why USE_FIND_ALGORITHM must stay out.
#
# This is a separate file because feature-push passed a materially WIDER exclude
# set than the other three workflows:
#
#   feature-push          [docs|src|.github|examples|deployments|common|plus|test]/**
#   dev/main/release      [src|.github]/**
#
# Both were invalid regexes that excluded nothing, so the difference never took
# effect at runtime -- but it was clearly intended. The feature-only directories
# all exist and hold ~86 tracked files (docs 4, examples 13, deployments 9,
# common 23, plus 10, test 27). Collapsing both workflows onto the narrower set
# would newly lint those 86 files on every feature push; collapsing onto the
# wider set would stop linting them on development and on release. Neither is a
# no-op, so the two sets are kept apart and each workflow keeps its own intent.
#
# `src/` does not currently exist in this repo but is retained to match the
# original intent.
#
# Keys are alphabetically ordered: dotenv-linter treats UnorderedKey as an error.
FILTER_REGEX_EXCLUDE=((docs|src|examples|deployments|common|plus|test)/.*|\.github/.*)
IGNORE_GITIGNORED_FILES=true
LOG_LEVEL=WARN
VALIDATE_ALL_CODEBASE=true
VALIDATE_BASH=false
VALIDATE_BASH_EXEC=false
VALIDATE_BIOME_FORMAT=false
VALIDATE_BIOME_LINT=false
VALIDATE_CHECKOV=false
VALIDATE_CLOUDFORMATION=false
VALIDATE_EDITORCONFIG=false
VALIDATE_GITLEAKS=false
VALIDATE_JAVASCRIPT_ES=false
VALIDATE_JAVASCRIPT_PRETTIER=false
VALIDATE_JAVASCRIPT_STANDARD=false
VALIDATE_JSON_PRETTIER=false
VALIDATE_MARKDOWN=false
VALIDATE_MARKDOWN_PRETTIER=false
VALIDATE_NATURAL_LANGUAGE=false
VALIDATE_SHELL_SHFMT=false
VALIDATE_SPELL_CODESPELL=false
VALIDATE_TERRAFORM_TFLINT=false
VALIDATE_TRIVY=false
VALIDATE_TYPESCRIPT_PRETTIER=false
VALIDATE_TYPESCRIPT_STANDARD=false
VALIDATE_YAML_PRETTIER=false
